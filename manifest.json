{
  "manifest_version": 3,
  "name": "Prompt Enhancer",
  "version": "0.1.0",
  "description": "Turns rough prompts into clear ones on any LLM site.",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["https://api.groq.com/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["adapters/chatgpt.js", "adapters/button.js"]
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["adapters/claude.js", "adapters/button.js"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "commands": {
    "enhance-prompt": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Enhance the prompt in the focused text box"
    }
  }
}